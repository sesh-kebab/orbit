{
  "name": "orbit",
  "productName": "Orbit",
  "version": "0.2.0",
  "description": "Orbit \u2014 an expressive desktop AI companion that orchestrates Copilot agents",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "sesh-kebab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesh-kebab/ai-desktop-companion.git"
  },
  "homepage": "https://github.com/sesh-kebab/ai-desktop-companion#readme",
  "bugs": {
    "url": "https://github.com/sesh-kebab/ai-desktop-companion/issues"
  },
  "keywords": [
    "electron",
    "desktop-assistant",
    "ai-agent",
    "copilot",
    "mcp",
    "orchestrator"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "snapshot": "electron-vite build && ORBIT_SNAPSHOT=1 electron .",
    "capture:assets": "node tools/capture/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.capture.json"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-vite": "^4.0.0",
    "gifenc": "^1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "vite": {
      "esbuild": "^0.28.2"
    }
  }
}
