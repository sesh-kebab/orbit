{
    "name": "orbit",
    "productName": "Orbit",
    "version": "0.3.0",
    "description": "Orbit — an expressive desktop AI companion that orchestrates Copilot agents",
    "main": "./out/main/index.js",
    "type": "module",
    "author": {
        "name": "sesh-kebab",
        "email": "sesh-kebab@users.noreply.github.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sesh-kebab/orbit.git"
    },
    "homepage": "https://github.com/sesh-kebab/orbit#readme",
    "bugs": {
        "url": "https://github.com/sesh-kebab/orbit/issues"
    },
    "keywords": [
        "electron",
        "desktop-assistant",
        "ai-agent",
        "copilot",
        "mcp",
        "orchestrator"
    ],
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "postinstall": "node tools/postinstall.mjs",
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "start": "electron-vite preview",
        "snapshot": "electron-vite build && ORBIT_SNAPSHOT=1 electron .",
        "capture:assets": "node tools/capture/run.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.capture.json",
        "verify": "node tools/verify.mjs",
        "verify:suppression": "esbuild scripts/verify-suppression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-suppression.mjs --log-level=warning && node node_modules/.cache/verify-suppression.mjs",
        "verify:freshness": "esbuild scripts/verify-freshness.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-freshness.mjs --log-level=warning && node node_modules/.cache/verify-freshness.mjs",
        "icons": "node tools/icons/run.mjs",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:mac": "npm run build && electron-builder --mac",
        "verify:activity": "esbuild scripts/verify-activity.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-activity.mjs --log-level=warning && node node_modules/.cache/verify-activity.mjs",
        "verify:calendar": "esbuild scripts/verify-calendar.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-calendar.mjs --log-level=warning && node node_modules/.cache/verify-calendar.mjs",
        "verify:board": "esbuild scripts/verify-board.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-board.mjs --log-level=warning && node node_modules/.cache/verify-board.mjs",
        "verify:agent-tools": "esbuild scripts/verify-agent-tools.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-agent-tools.mjs --log-level=warning && node node_modules/.cache/verify-agent-tools.mjs",
        "verify:render": "esbuild scripts/verify-render.ts --bundle --platform=node --format=esm --jsx=automatic --external:react --external:react-dom --outfile=node_modules/.cache/verify-render.mjs --log-level=warning && node node_modules/.cache/verify-render.mjs",
        "verify:meetings": "esbuild scripts/verify-meetings.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-meetings.mjs --log-level=warning && node node_modules/.cache/verify-meetings.mjs",
        "verify:landed": "esbuild scripts/verify-landed.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-landed.mjs --log-level=warning && node node_modules/.cache/verify-landed.mjs",
        "verify:openitems": "esbuild scripts/verify-openitems.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-openitems.mjs --log-level=warning && node node_modules/.cache/verify-openitems.mjs",
        "landed": "node tools/landed.mjs",
        "verify:prompt": "esbuild scripts/verify-prompt.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-prompt.mjs --log-level=warning && node node_modules/.cache/verify-prompt.mjs",
        "verify:memory": "esbuild scripts/verify-memory.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-memory.mjs --log-level=warning && node node_modules/.cache/verify-memory.mjs"
    },
    "dependencies": {
        "@github/copilot-sdk": "^1.0.8",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^4.0.0",
        "gifenc": "^1.0.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.0",
        "vite": "^7.3.6"
    },
    "overrides": {
        "vite": {
            "esbuild": "^0.28.2"
        },
        "@xmldom/xmldom": "0.8.13",
        "@peculiar/asn1-schema": "2.8.0"
    }
}
